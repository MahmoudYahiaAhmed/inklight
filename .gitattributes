# Normalise line endings in the repository; check out with the platform's native endings.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
Dockerfile text eol=lf
*.patch text eol=lf
*.log text eol=lf

# Binary fixtures and assets
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary
